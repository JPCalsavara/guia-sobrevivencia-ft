current_branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$current_branch" = "main" ] && [ "$ALLOW_MAIN_COMMIT" != "1" ]; then
  echo "Bloqueio de branch ativo: comissoes diretas na branch main sao proibidas pelo ADR 0008." >&2
  echo "Trabalhe em uma branch feature, fix ou release e integre suas mudancas via git merge." >&2
  exit 1
fi

npm run vectorize
if git diff --name-only | grep -q "src/data/searchIndex.ts"; then
  git add src/data/searchIndex.ts
fi
npm test
